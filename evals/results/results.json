  "section_9_limitations": {
    "synthetic_author_parity": "Datasets are synthetic and generated by the same codebase author as the detectors. These evaluations prove that the detectors reliably recover what the generator plants, not that real-world retail options traders behave in this exact parametric manner.",
    "forced_loss_flattery": {
      "description": "Planted loss habits are artificially forced to be losing trades in several generator methods, which guarantees a clean distinction between baseline trades and habit-induced trades, flattering cost ratios.",
      "affected_habits": [
        "holding_losers: extends hold time specifically for trades already destined to lose, ensuring extended losers have larger losses.",
        "revenge_trading: explicitly overrides pnl_inr to a forced negative loss on re-entries following losing trades.",
        "overtrading: explicitly forces trades above the daily baseline volume threshold to be losing trades.",
        "oversizing: explicitly forces position sizes following two consecutive wins or losses to result in losing trades.",
        "averaging_down: samples exclusively from losing positions and injects lower-priced add-on orders that exit at a net loss."
      ]
    },
    "gross_pnl_lower_bounds": "All calculations rely purely on gross P&L (exit price minus entry price times quantity). Brokerage charges, Securities Transaction Tax (STT), exchange turnover fees, and GST are not included. Reported habit costs therefore represent strict lower bounds on the total capital destroyed.",
    "proportional_overlap_approximation": "Portfolio overlap attribution is computed using a proportional-by-count approximation (attributed_cost_inr = estimated_cost_inr * (1 - overlap_share)), not an exact combinatorial per-trade attribution. This provides a deterministic, transparent adjustment but remains a heuristic approximation.",
    "confidence_semantics": "Confidence scores reflect evidence volume and behavioral extremity (e.g., hold-time ratios, cooldown violation speed), not a frequentist or Bayesian probability of recurrence.",
    "threshold_calibration_history": [
      "holding_losers 5a: replaced mean ratio with median ratio (flagged_median_hold / median_winner_hold) to ensure resistance to outliers.",
      "oversizing: derived position thresholds dynamically from trader's median lot size instead of hardcoded 2 lots.",
      "holding_losers confidence: corrected to compare flagged losers' median hold against winning trades rather than all losers."
    ]
  }
}